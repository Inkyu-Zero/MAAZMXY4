<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MFAAvalonia.Views.UserControls.TeachingTipOverlay" IsVisible="False">
    <Grid x:Name="OverlayRoot">
        <Canvas>
            <Border x:Name="OverlayMask" IsVisible="False" IsHitTestVisible="False"
                    BorderThickness="2" CornerRadius="7" BorderBrush="{DynamicResource SukiPrimaryColor}" Background="#108497B0" />
            <Border x:Name="TipBorder" CornerRadius="10" Padding="16" IsHitTestVisible="True"
                    BorderBrush="{DynamicResource SukiPrimaryColor}" BorderThickness="1"
                    Background="{DynamicResource SukiCardBackground}">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock x:Name="TipTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SukiText}" />
                        <TextBlock x:Name="StepCount" Grid.Column="1" FontSize="12" VerticalAlignment="Top"
                                   Foreground="{DynamicResource SukiText}" Opacity=".7" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TipDescription" FontSize="13" TextWrapping="Wrap" LineHeight="22"
                                   Foreground="{DynamicResource SukiText}" />
                    </ScrollViewer>
                    <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
                        <Button x:Name="CloseButton" Content="跳过本页" Margin="0,0,6,4" Padding="10,6" />
                        <Button x:Name="PrevButton" Content="上一步" Margin="0,0,6,4" Padding="10,6" />
                        <Button x:Name="NextButton" Content="下一步" Margin="0,0,0,4" Padding="10,6" />
                    </WrapPanel>
                </Grid>
            </Border>
            <Polygon x:Name="TipArrow" Fill="{DynamicResource SukiPrimaryColor}" IsVisible="False" IsHitTestVisible="False" />
        </Canvas>
    </Grid>
</UserControl>
