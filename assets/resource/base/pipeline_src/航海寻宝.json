  "航海寻宝_次数为零": {
    "recognition": {
      "type": "OCR",
      "param": {
        "expected": [
          "剩余可领取次数\\s*[：:]\\s*[0O〇○]"
        ],
        "roi": [
          "19.2%",
          "59.0%",
          "38.4%",
          "6.9%"
        ]
      }
    },
    "action": {
      "type": "DoNothing"
    },
    "next": [
      "航海寻宝_结束_领完"
    ],
    "timeout": 1500,
    "on_error": [
      "航海寻宝_次数有剩"
    ]
  },
  "航海寻宝_次数有剩": {
    "recognition": {
      "type": "OCR",
