{
  "航海寻宝_入口": {
    "recognition": {
      "type": "DirectHit"
    },
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "voyage_run"
      }
    },
    "next": [
      "航海寻宝_收尾"
    ],
    "on_error": [
      "航海寻宝_收尾"
    ]
  },
  "航海寻宝_结束": {
    "recognition": {
      "type": "DirectHit"
    },
    "action": {
      "type": "StopTask"
    },
    "next": []
  },
  "航海寻宝_导航入口": {
    "recognition": {
      "type": "DirectHit"
    },
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "adventure_entry_route",
        "custom_action_param": {
          "entry_node": "航海寻宝_导航入口",
          "icon_node": "航海寻宝_点图标",
          "close_node": "航海寻宝_识别红叉",
          "close_click_node": "航海寻宝_点红叉",
          "back_node": "航海寻宝_返回地图",
          "settings_node": "航海寻宝_点设置",
          "menu_node": "航海寻宝_识别菜单",
          "panels": [
            {
              "node": "航海寻宝_面板",
              "target": "航海寻宝_面板"
            }
          ],
          "pipeline": "航海寻宝.json",
          "wu_node": "航海寻宝_识别无双",
          "world_node": "航海寻宝_识别世界",
          "world_click_node": "航海寻宝_点南瞻部洲",
          "map_node": "航海寻宝_识别世界图标"
        }
      }
    },
    "next": [
      "航海寻宝_点图标"
    ],
    "timeout": 20000
  },
  "航海寻宝_点图标": {
    "recognition": {
      "type": "DirectHit"
    },
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "voyage_click_icon"
      }
    },
    "next": [
      "航海寻宝_次数为零",
      "航海寻宝_次数有剩"
    ],
    "timeout": 8000,
    "post_delay": 250,
    "post_wait_freezes": {
      "time": 250,
      "timeout": 2500,
      "rate_limit": 200
    }
  },
  "航海寻宝_起航": {
    "recognition": {
      "type": "OCR",
      "param": {
        "expected": [
          "起航"
        ]
