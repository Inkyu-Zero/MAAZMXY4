  },
  "航海寻宝_结束_单次": {
    "recognition": {
      "type": "DirectHit"
    },
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "adventure_voyage_done",
        "custom_action_param": {
          "mode": "once"
        }
      }
    },
    "focus": {
      "Node.Action.Succeeded": {
        "content": "./debug/adventure/voyage_done.md",
        "display": "log"
      }
    },
    "next": [
      "航海寻宝_结束"
    ]
  },
