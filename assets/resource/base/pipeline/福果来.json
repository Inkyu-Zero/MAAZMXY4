{
  "福果来_展开菜单": {
    "recognition": {
      "type": "DirectHit"
    },
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "fuguo_click_arrow"
      }
    },
    "next": [
      "福果来_点图标"
    ],
    "on_error": [
      "福果来_点图标"
    ],
    "post_delay": 120,
    "post_wait_freezes": {
      "time": 150,
      "timeout": 1200,
      "rate_limit": 80
    },
    "timeout": 800
  },
  "福果来_点图标": {
    "recognition": {
      "type": "DirectHit"
    },
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "fuguo_find_icon"
      }
    },
    "next": [
      "福果来_进入副本"
    ],
    "on_error": [
      "福果来_入口"
    ],
    "timeout": 8000
  },
  "福果来_入口": {
    "recognition": {
      "type": "DirectHit"
    },
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "adventure_entry_route",
        "custom_action_param": {
          "entry_node": "福果来_入口",
          "icon_node": "福果来_点图标",
          "map_node": "福果来_回地图",
          "back_node": "福果来_返回地图",
          "settings_node": "福果来_点设置",
          "big_map_node": "福果来_识别大地图",
          "arrow_node": "福果来_展开菜单",
          "close_node": "福果来_识别红叉",
          "close_click_node": "福果来_点红叉",
          "panels": [
            {
              "node": "福果来_面板",
              "target": "福果来_面板"
            }
          ],
          "dungeon_node": "福果来_识别副本",
          "dungeon_target": "福果来_副本内"
        }
      }
    },
    "next": [
      "福果来_识别菜单",
      "福果来_识别大地图",
      "福果来_识别副本",
      "福果来_回地图"
    ],
    "timeout": 20000
  },
  "福果来_识别菜单": {
    "recognition": {
      "type": "OCR",
      "param": {
        "expected": [
          "福果来"
        ],
        "roi": [
          290,
          90,
          900,
          700
        ]
      }
    },
    "action": {
      "type": "DoNothing"
    },
    "next": [
      "福果来_点图标"
    ],
    "timeout": 800
  },
  "福果来_回地图": {
    "recognition": {
      "type": "DirectHit"
    },
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "adventure_goto_map"
      }
    },
    "next": [
      "福果来_入口"
    ],
    "timeout": 130000,
    "on_error": [
      "福果来_返回地图"
    ]
  },
  "福果来_识别大地图": {
    "recognition": {
      "type": "And",
      "param": {
        "all_of": [
          "Nav_ClearMap"
        ]
      }
    },
    "action": {
      "type": "DoNothing"
    },
    "next": [
      "福果来_展开菜单"
    ],
    "on_error": [
      "福果来_回地图"
    ],
    "timeout": 800
  },
  "福果来_返回地图": {
    "recognition": {
      "type": "OCR",
      "param": {
        "expected": [
          "返回地图"
        ]
      }
    },
    "action": {
      "type": "Click"
    },
    "next": [
      "福果来_入口"
    ],
    "on_error": [
      "福果来_点设置"
    ],
    "timeout": 2500,
    "post_delay": 300,
    "post_wait_freezes": {
      "time": 200,
      "timeout": 3000,
      "rate_limit": 200
    }
  },
  "福果来_识别红叉": {
    "recognition": {
      "type": "TemplateMatch",
      "param": {
        "template": [
          "ui/close_x.png",
          "ui/close_x_1410.png"
        ],
        "roi": [
          860,
          0,
          353,
          270
        ],
        "threshold": 0.8
      }
    },
    "action": {
      "type": "DoNothing"
    },
    "next": [],
    "timeout": 800
  },
  "福果来_点红叉": {
    "recognition": {
      "type": "TemplateMatch",
      "param": {
        "template": [
          "ui/close_x.png",
          "ui/close_x_1410.png"
        ],
        "roi": [
          860,
          0,
          353,
          270
        ],
        "threshold": 0.8
      }
    },
    "action": {
      "type": "Click"
    },
    "next": [
      "福果来_入口"
    ],
    "on_error": [
      "福果来_入口"
    ],
    "timeout": 800,
    "post_delay": 400,
    "post_wait_freezes": {
      "time": 200,
      "timeout": 3000,
      "rate_limit": 200
    }
  },
  "福果来_点设置": {
    "recognition": {
      "type": "OCR",
      "param": {
