    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "fuguo_daily_done"
      }
    },
    "next": [
      "福果来_结束"
    ],
    "focus": {
      "Node.Action.Succeeded": {
        "content": "./debug/fuguo/score.md",
        "display": "log"
      }
    },
    "timeout": 3000
  },
  "福果来_结束": {
    "recognition": {
      "type": "DirectHit"
    },
    "action": {
      "type": "StopTask"
    },
    "next": []
  },
