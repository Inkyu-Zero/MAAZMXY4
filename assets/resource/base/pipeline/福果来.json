          "^设置$"
        ]
      }
    },
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "adventure_click_settings"
      }
    },
    "next": [
      "福果来_返回地图复检"
    ],
    "on_error": [
      "福果来_回地图"
    ],
    "timeout": 4000
  },
  "福果来_返回地图复检": {
    "recognition": {
      "type": "OCR",
      "param": {
        "expected": [
          "返回地图"
        ]
      }
    },
    "action": {
      "type": "Click"
    },
    "next": [
      "福果来_入口"
    ],
    "on_error": [
      "福果来_回地图"
    ],
    "timeout": 2500,
    "post_delay": 300,
    "post_wait_freezes": {
      "time": 200,
      "timeout": 3000,
      "rate_limit": 200
    }
  },
  "福果来_进入副本": {
    "recognition": {
      "type": "OCR",
      "param": {
        "expected": [
          "进入副本"
        ]
      }
    },
    "action": {
      "type": "Click"
    },
    "next": [
      "福果来_确认进入"
    ],
    "on_error": [
      "福果来_入口"
    ],
    "timeout": 20000,
    "post_wait_freezes": {
      "time": 1200,
      "timeout": 30000,
      "rate_limit": 200
    }
  },
  "福果来_确认进入": {
    "recognition": {
      "type": "OCR",
      "param": {
        "expected": [
          "倒计时"
        ],
        "roi": [
          500,
          0,
          480,
          90
        ]
      }
    },
    "action": {
      "type": "DoNothing"
    },
    "next": [
      "福果来_副本内"
    ],
    "on_error": [
      "福果来_本日已完成"
    ],
    "timeout": 4000,
    "pre_delay": 1800
  },
  "福果来_副本内": {
    "recognition": {
      "type": "DirectHit"
    },
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "fuguo_run"
      }
    },
    "next": [
      "福果来_结算"
    ],
    "on_error": [
      "福果来_入口"
    ]
  },
  "福果来_结算": {
    "recognition": {
      "type": "DirectHit"
    },
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "fuguo_check_score"
      }
    },
    "next": [
      "福果来_领取奖励"
    ],
    "on_error": [
      "福果来_重跑"
    ],
    "timeout": 5000,
    "focus": {
      "Node.Action.Succeeded": {
        "content": "./debug/fuguo/score.md",
        "display": "log"
      }
    }
  },
  "福果来_读积分": {
    "recognition": {
      "type": "OCR",
      "param": {
