{
    "Adventure_识别红叉": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "ui/close_x.png"
                ],
                "roi": [
                    700,
                    0,
                    447,
                    260
                ],
                "threshold": 0.65,
                "green_mask": true
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "Adventure_点红叉"
        ],
        "timeout": 500
    },
