{
  "航海寻宝_入口": {
    "recognition": {
      "type": "DirectHit"
    },
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "voyage_run"
      }
    },
    "next": [
      "航海寻宝_收尾"
    ],
    "on_error": [
      "航海寻宝_收尾"
    ]
  },
  "航海寻宝_结束": {
    "recognition": {
      "type": "DirectHit"
    },
    "action": {
      "type": "StopTask"
    },
    "next": []
  },
  "航海寻宝_导航入口": {
    "recognition": {
      "type": "DirectHit"
    },
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "adventure_entry_route",
        "custom_action_param": {
          "entry_node": "航海寻宝_导航入口",
          "icon_node": "航海寻宝_点图标",
          "map_node": "航海寻宝_回地图",
          "back_node": "航海寻宝_返回地图",
          "big_map_node": "航海寻宝_识别大地图",
          "arrow_node": "航海寻宝_展开菜单",
          "close_node": "航海寻宝_识别红叉",
          "close_click_node": "航海寻宝_点红叉",
          "settings_node": "航海寻宝_点设置",
          "panels": [
            {
              "node": "航海寻宝_面板",
              "target": "航海寻宝_次数为零"
            }
          ]
        }
      }
    },
    "timeout": 12000,
    "next": [
      "航海寻宝_点图标"
    ]
  },
  "航海寻宝_点图标": {
    "recognition": {
      "type": "DirectHit"
    },
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "voyage_click_icon"
      }
    },
    "next": [
      "航海寻宝_次数为零",
      "航海寻宝_次数有剩"
    ],
    "timeout": 8000,
    "post_delay": 300,
    "post_wait_freezes": {
      "time": 250,
      "timeout": 2500,
      "rate_limit": 200
    }
  },
  "航海寻宝_起航": {
    "recognition": {
      "type": "OCR",
      "param": {
        "expected": [
          "起航"
        ]
      }
    },
    "action": {
      "type": "Click"
    },
    "next": [
      "航海寻宝_入口"
    ],
    "timeout": 2500,
    "post_delay": 300,
    "post_wait_freezes": {
      "time": 200,
      "timeout": 3000,
      "rate_limit": 200
    }
  },
  "航海寻宝_再起航": {
    "recognition": {
      "type": "OCR",
      "param": {
        "expected": [
          "起航"
        ]
      }
    },
    "action": {
      "type": "Click"
    },
    "next": [
      "航海寻宝_入口"
    ],
    "on_error": [
      "航海寻宝_收尾"
    ],
    "timeout": 3000,
    "post_delay": 600,
    "post_wait_freezes": {
      "time": 300,
      "timeout": 4000,
      "rate_limit": 200
    }
  },
  "航海寻宝_执行日": {
    "recognition": {
      "type": "DirectHit"
    },
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "adventure_weekday_gate",
        "custom_action_param": {
          "weekday": 0
        }
      }
    },
    "next": [
      "航海寻宝_导航入口"
    ],
    "on_error": [
      "航海寻宝_结束"
    ],
    "timeout": 3000
  },
  "航海寻宝_展开菜单": {
    "recognition": {
      "type": "TemplateMatch",
      "param": {
        "template": [
          "survival/arrow.png",
          "survival/arrow_1410.png"
        ],
        "roi": [
          780,
          0,
          451,
          123
        ],
        "threshold": 0.6
      }
    },
    "action": {
      "type": "Click"
    },
    "next": [
      "航海寻宝_点图标"
    ],
    "on_error": [
      "航海寻宝_点图标"
    ],
    "timeout": 800
  },
  "航海寻宝_识别大地图": {
    "recognition": {
      "type": "And",
      "param": {
        "all_of": [
          "Nav_ClearMap"
        ]
      }
    },
    "action": {
      "type": "DoNothing"
    },
    "next": [
      "航海寻宝_展开菜单"
    ],
    "on_error": [
      "航海寻宝_回地图"
    ],
    "timeout": 800
  },
  "航海寻宝_回地图": {
    "recognition": {
      "type": "DirectHit"
    },
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "adventure_goto_map"
      }
    },
    "next": [
      "航海寻宝_导航入口"
    ],
    "on_error": [
      "航海寻宝_结束"
    ],
    "timeout": 130000
  },
  "航海寻宝_返回地图": {
    "recognition": {
      "type": "OCR",
      "param": {
        "expected": [
          "返回地图"
        ]
      }
    },
    "action": {
      "type": "Click"
    },
    "next": [
      "航海寻宝_导航入口"
    ],
    "on_error": [
      "航海寻宝_点设置"
    ],
    "timeout": 2500,
    "post_delay": 300,
    "post_wait_freezes": {
      "time": 200,
      "timeout": 3000,
      "rate_limit": 200
    }
  },
  "航海寻宝_识别红叉": {
    "recognition": {
      "type": "TemplateMatch",
      "param": {
        "template": [
          "ui/close_x.png",
          "ui/close_x_1410.png"
        ],
        "roi": [
          860,
          0,
          353,
          270
        ],
        "threshold": 0.8
      }
    },
    "action": {
      "type": "DoNothing"
    },
    "next": [],
    "timeout": 800
  },
  "航海寻宝_点红叉": {
    "recognition": {
      "type": "TemplateMatch",
      "param": {
        "template": [
          "ui/close_x.png",
          "ui/close_x_1410.png"
        ],
        "roi": [
          860,
          0,
          353,
          270
        ],
        "threshold": 0.8
      }
    },
    "action": {
      "type": "Click"
    },
    "next": [
      "航海寻宝_导航入口"
    ],
    "on_error": [
      "航海寻宝_导航入口"
    ],
    "timeout": 800,
    "post_delay": 400,
    "post_wait_freezes": {
      "time": 200,
      "timeout": 3000,
      "rate_limit": 200
    }
  },
  "航海寻宝_点设置": {
    "recognition": {
      "type": "OCR",
      "param": {
        "expected": [
          "^设置$"
        ]
      }
    },
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "adventure_click_settings"
      }
    },
    "next": [
      "航海寻宝_返回地图复检"
    ],
    "on_error": [
      "航海寻宝_回地图"
    ],
    "timeout": 4000
  },
  "航海寻宝_领取奖励": {
    "recognition": {
      "type": "OCR",
      "param": {
        "expected": [
          "^领取奖励$"
        ]
      }
    },
    "action": {
      "type": "Click"
    },
    "next": [
      "航海寻宝_次数为零",
      "航海寻宝_领取后起航"
    ],
    "timeout": 2500,
    "post_delay": 600,
    "post_wait_freezes": {
      "time": 300,
      "timeout": 4000,
      "rate_limit": 200
    }
  },
  "航海寻宝_返回地图复检": {
    "recognition": {
      "type": "OCR",
      "param": {
        "expected": [
          "返回地图"
        ]
      }
    },
    "action": {
      "type": "Click"
    },
    "next": [
      "航海寻宝_导航入口"
    ],
    "on_error": [
      "航海寻宝_回地图"
    ],
    "timeout": 2500,
    "post_delay": 300,
    "post_wait_freezes": {
      "time": 200,
      "timeout": 3000,
      "rate_limit": 200
    }
  },
  "航海寻宝_领取后起航": {
    "recognition": {
      "type": "OCR",
      "param": {
        "expected": [
          "起航"
        ]
      }
    },
    "action": {
      "type": "Click"
    },
    "next": [
      "航海寻宝_入口"
    ],
    "on_error": [
      "航海寻宝_次数为零"
    ],
    "timeout": 2500,
    "post_delay": 300,
    "post_wait_freezes": {
      "time": 200,
      "timeout": 3000,
      "rate_limit": 200
    }
  },
  "航海寻宝_收尾": {
    "recognition": {
      "type": "OCR",
      "param": {
        "expected": [
          "返回地图"
        ]
      }
    },
    "action": {
      "type": "Click"
    },
    "next": [
      "航海寻宝_导航入口"
    ],
    "on_error": [
      "航海寻宝_结束"
    ],
    "timeout": 2500
  },
  "航海寻宝_次数为零": {
    "recognition": {
      "type": "OCR",
      "param": {
        "expected": [
          "剩余可领取次数\\s*[：:]\\s*[0O〇○]"
        ],
        "roi": [
          220,
          425,
          440,
          50
        ]
      }
    },
    "action": {
      "type": "DoNothing"
    },
    "next": [
      "航海寻宝_结束_领完"
    ],
    "timeout": 1500,
    "on_error": [
      "航海寻宝_次数有剩"
    ]
  },
  "航海寻宝_次数有剩": {
    "recognition": {
      "type": "OCR",
      "param": {
        "expected": [
          "剩余可领取次数\\s*[：:]\\s*[1-9]"
        ],
        "roi": [
          220,
          425,
          440,
          50
        ]
      }
    },
    "action": {
      "type": "DoNothing"
    },
    "next": [
      "航海寻宝_起航",
      "航海寻宝_领取奖励"
    ],
    "timeout": 1500
  },
  "航海寻宝_结束_单次": {
    "recognition": {
      "type": "DirectHit"
    },
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "adventure_voyage_done",
        "custom_action_param": {
          "mode": "once"
        }
      }
    },
    "focus": {
      "Node.Action.Succeeded": {
        "content": "./debug/adventure/voyage_done.md",
        "display": "log"
      }
    },
    "next": [
      "航海寻宝_结束"
    ]
  },
  "航海寻宝_结束_领完": {
    "recognition": {
      "type": "DirectHit"
    },
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "adventure_voyage_done",
        "custom_action_param": {
          "mode": "cleared"
        }
      }
    },
    "focus": {
      "Node.Action.Succeeded": {
        "content": "./debug/adventure/voyage_done.md",
        "display": "log"
      }
    },
    "next": [
      "航海寻宝_结束"
    ]
  },
  "航海寻宝_面板": {
    "recognition": {
      "type": "OCR",
      "param": {
        "expected": [
          "剩余可领取次数"
        ],
        "roi": [
          220,
          425,
          440,
          50
        ]
      }
    },
    "action": {
      "type": "DoNothing"
    },
    "next": [
      "航海寻宝_次数为零"
    ],
    "timeout": 1200
  }
}
