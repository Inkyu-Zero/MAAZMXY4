{
    "扫荡须弥山_入口": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "adventure_entry_route",
                "custom_action_param": {
                    "entry_node": "扫荡须弥山_入口",
                    "icon_node": "扫荡须弥山_点图标",
                    "close_node": "Adventure_识别红叉",
                    "close_click_node": "Adventure_点红叉",
                    "back_node": "Adventure_返回地图",
                    "settings_node": "Adventure_点设置",
                    "menu_node": "扫荡须弥山_识别菜单",
                    "panels": [],
                    "pipeline": "扫荡须弥山.json",
                    "wu_node": "Adventure_识别无双",
                    "menu_hsv": [
                        55,
                        150,
                        50,
                        80,
                        255,
                        190
                    ],
                    "map_node": "Adventure_识别世界",
                    "world_node": "Adventure_识别南瞻部洲"
                }
            }
        },
        "next": [
            "扫荡须弥山_识别菜单"
        ],
        "on_error": [
            "扫荡须弥山_识别菜单"
        ],
        "timeout": 20000
    },
    "扫荡须弥山_识别菜单": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "richanghuodong/shouhuxumishan.png"
                ],
                "roi": [
                    290,
                    90,
                    660,
                    500
                ],
                "green_mask": true,
                "threshold": 0.7
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "扫荡须弥山_点图标"
        ],
        "timeout": 800,
        "on_error": [
            "扫荡须弥山_入口"
        ]
    },
    "扫荡须弥山_点图标": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "richanghuodong/shouhuxumishan.png"
                ],
                "roi": [
                    290,
                    90,
                    660,
                    500
                ],
                "green_mask": true,
                "threshold": 0.7
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "扫荡须弥山_扫描流程"
        ],
        "on_error": [
            "扫荡须弥山_入口"
        ],
        "timeout": 1500,
        "post_delay": 800
    },
    "扫荡须弥山_结束": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "next": []
    },
    "扫荡须弥山_扫描流程": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "xumishan_run"
            }
        },
        "next": [
            "扫荡须弥山_结束"
        ],
        "on_error": [
            "扫荡须弥山_结束"
        ],
        "timeout": 300000
    }
}