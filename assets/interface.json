{
  "interface_version": 2,
  "name": "MAA造梦西游4",
  "label": "MAAZMXY4",
  "github": "https://github.com/Inkyu-Zero/MAAZMXY4",
  "version": "0.4",
  "controller": [
    {
      "name": "桌面端",
      "type": "Win32",
      "win32": {
        "class_regex": ".*",
        "window_regex": "造梦盒子"
      }
    }
  ],
  "resource": [
    {
      "name": "默认",
      "path": [
        "./resource/base"
      ]
    }
  ],
  "task": [
    {
      "name": "进入游戏",
      "entry": "点击账号",
      "description": "自动登录并进入游戏。\n\n**使用前**：在上方设置「账号名称」和「存档序号」（1-8）。\n流程：选账号 → 进游戏 → 点开始游戏 → 选存档",
      "option": [
        "账号名称",
        "存档序号"
      ]
    },
    {
      "name": "刷取灵魂",
      "entry": "刷取点击世界",
      "description": "自动刷取灵魂，直到刷满「循环次数」轮或灵魂数读满。\n\n- **循环次数**：刷几轮后停止\n- **卡死重启**：开=卡死/失败时自动 ESC 重启并重登（最多3次）\n\n**使用前**：确认已进游戏，并在上方设置「循环次数」「账号名称」「存档序号」。\n\n- **目前只支持剑阵+法宝秒杀大盗**",
      "option": [
        "循环次数",
        "账号名称",
        "存档序号",
        "卡死重启"
      ]
    },
    {
      "name": "领取奖励",
      "entry": "领取奖励入口",
      "description": "自动导航到南瞻部洲 / 须弥山，按两组处理 7 项奖励/活动面板，每一项可单独开关。\n\n- 识别到对应按钮 → 点击领取 → 点右上角「叉」关闭\n- 识别不到按钮 → 跳过该项继续下一项（当天已领过也能正常跳过）\n- 界面不在（识别不到「世界」）→ 直接结束，不报错",
      "option": [
        "领取vip每日奖励",
        "领取暑假来就送奖励",
        "进行联盟贡献",
        "冒险领取骰子",
        "领取十五天登录奖励",
        "领取宠物养成并重新采集",
        "领取坐骑养成并重新采集"
      ]
    },
    {
      "name": "清日常",
      "entry": "清日常入口",
      "description": "每一项可单独开关。\n\n- 识别到对应按钮 → 点击进入 → 扫荡 → 点右上角「叉」关闭\n- 识别不到按钮 → 跳过该项继续下一项（当天已扫过也能正常跳过）\n- 界面不在（识别不到「世界」）→ 直接结束，不报错",
      "option": [
        "扫荡竞技场",
        "打斗宠大会",
        "扫荡守护须弥山",
        "扫荡噩梦诛仙四剑",
        "噩梦四剑扫荡次数",
        "扫荡噩梦冥河老祖",
        "噩梦冥河老祖扫荡次数"
      ]
    }
  ],
  "option": {
    "账号名称": {
      "type": "input",
      "inputs": [
        {
          "name": "账号名称",
          "pipeline_type": "string"
        }
      ],
      "pipeline_override": {
        "选择账号": {
          "expected": "{账号名称}"
        },
        "重进选择账号": {
          "expected": "{账号名称}"
        }
      }
    },
    "存档序号": {
      "type": "input",
      "inputs": [
        {
          "name": "存档序号",
          "pipeline_type": "int",
          "default": "1",
          "verify": "^[1-8]$"
        }
      ],
      "pipeline_override": {
        "选择存档": {
          "recognition": {
            "param": {
              "template": [
                "存档{存档序号}.png"
              ]
            }
          }
        },
        "重进选择存档": {
          "recognition": {
            "param": {
              "template": [
                "存档{存档序号}.png"
              ]
            }
          }
        }
      }
    },
    "循环次数": {
      "type": "input",
      "inputs": [
        {
          "name": "循环次数",
          "pipeline_type": "int",
          "default": "1",
          "verify": "^[1-9][0-9]*$"
        }
      ],
      "pipeline_override": {
        "刷取次数": {
          "max_hit": "{循环次数}"
        }
      }
    },
    "卡死重启": {
      "type": "switch",
      "label": "卡死/失败自动重启",
      "description": "刷取过程中游戏卡死或任务失败时，自动按 ESC → 确定 → 重新登录继续刷取；重启满 3 次仍失败则停止。",
      "default_case": "No",
      "cases": [
        {
          "name": "Yes",
          "pipeline_override": {
            "刷取次数": {
              "on_error": [
                "重启判断"
              ]
            },
            "点击任务": {
              "on_error": [
                "重启判断"
              ]
            },
            "点击悬赏任务": {
              "on_error": [
                "重启判断"
              ]
            },
            "点击前往副本": {
              "on_error": [
                "重启判断"
              ]
            },
            "成功进入遁地大盗关卡": {
              "on_error": [
                "重启判断"
              ]
            },
            "点击C关闭背包": {
              "on_error": [
                "重启判断"
              ]
            },
            "使用法宝": {
              "on_error": [
                "重启判断"
              ]
            },
            "使用剑阵": {
              "on_error": [
                "重启判断"
              ]
            },
            "遁地大盗死亡": {
              "on_error": [
                "重启判断"
              ]
            },
            "点击设置": {
              "on_error": [
                "重启判断"
              ]
            },
            "返回地图": {
              "on_error": [
                "重启判断"
              ]
            },
            "重进确定": {
              "on_error": [
                "重启判断"
              ]
            },
            "重进点击账号": {
              "on_error": [
                "重启判断"
              ]
            },
            "重进选择账号": {
              "on_error": [
                "重启判断"
              ]
            },
            "重进进入造梦西游4": {
              "on_error": [
                "重启判断"
              ]
            },
            "重进点击开始游戏": {
              "on_error": [
                "重启判断"
              ]
            }
          }
        },
        {
          "name": "No",
          "pipeline_override": {}
        }
      ]
    },
    "领取vip每日奖励": {
      "type": "switch",
      "label": "领取vip每日奖励",
      "default_case": "Yes",
      "cases": [
        { "name": "Yes", "pipeline_override": { "vip每日入口": { "next": ["点击vip"] } } },
        { "name": "No",  "pipeline_override": { "vip每日入口": { "next": ["暑假入口"] } } }
      ]
    },
    "领取暑假来就送奖励": {
      "type": "switch",
      "label": "领取暑假来就送奖励",
      "default_case": "Yes",
      "cases": [
        { "name": "Yes", "pipeline_override": { "暑假入口": { "next": ["点击暑假来就送"] } } },
        { "name": "No",  "pipeline_override": { "暑假入口": { "next": ["登录入口"] } } }
      ]
    },
    "进行联盟贡献": {
      "type": "switch",
      "label": "进行联盟贡献",
      "default_case": "Yes",
      "cases": [
        { "name": "Yes", "pipeline_override": { "联盟入口": { "next": ["点击联盟"] } } },
        { "name": "No",  "pipeline_override": { "联盟入口": { "next": ["骰子入口"] } } }
      ]
    },
    "冒险领取骰子": {
      "type": "switch",
      "label": "冒险领取骰子",
      "default_case": "Yes",
      "cases": [
        { "name": "Yes", "pipeline_override": { "骰子入口": { "next": ["点击日常活动"] } } },
        { "name": "No",  "pipeline_override": { "骰子入口": { "next": ["宠物入口"] } } }
      ]
    },
    "领取十五天登录奖励": {
      "type": "switch",
      "label": "领取十五天登录奖励",
      "default_case": "Yes",
      "cases": [
        { "name": "Yes", "pipeline_override": { "登录入口": { "next": ["点击十五天登录"] } } },
        { "name": "No",  "pipeline_override": { "登录入口": { "next": ["点击须弥山"] } } }
      ]
    },
    "领取宠物养成并重新采集": {
      "type": "switch",
      "label": "领取宠物养成并重新采集",
      "default_case": "Yes",
      "cases": [
        { "name": "Yes", "pipeline_override": { "宠物入口": { "next": ["点击宠物养成"] } } },
        { "name": "No",  "pipeline_override": { "宠物入口": { "next": ["坐骑入口"] } } }
      ]
    },
    "领取坐骑养成并重新采集": {
      "type": "switch",
      "label": "领取坐骑养成并重新采集",
      "default_case": "Yes",
      "cases": [
        { "name": "Yes", "pipeline_override": { "坐骑入口": { "next": ["点击坐骑养成"] } } },
        { "name": "No",  "pipeline_override": { "坐骑入口": { "next": ["领取完毕"] } } }
      ]
    },
    "扫荡竞技场": {
      "type": "switch",
      "label": "扫荡竞技场",
      "default_case": "Yes",
      "cases": [
        { "name": "Yes", "pipeline_override": { "竞技场入口": { "next": ["竞技场点击日常活动"] } } },
        { "name": "No",  "pipeline_override": { "竞技场入口": { "next": ["斗宠大会入口"] } } }
      ]
    },
    "打斗宠大会": {
      "type": "switch",
      "label": "打斗宠大会",
      "default_case": "Yes",
      "cases": [
        { "name": "Yes", "pipeline_override": { "斗宠大会入口": { "next": ["斗宠大会点击日常活动"] } } },
        { "name": "No",  "pipeline_override": { "斗宠大会入口": { "next": ["扫荡守护须弥山入口"] } } }
      ]
    },
    "扫荡守护须弥山": {
      "type": "switch",
      "label": "扫荡守护须弥山",
      "default_case": "Yes",
      "cases": [
        { "name": "Yes", "pipeline_override": { "扫荡守护须弥山入口": { "next": ["守护须弥山点击日常活动"] } } },
        { "name": "No",  "pipeline_override": { "扫荡守护须弥山入口": { "next": ["扫荡噩梦诛仙四剑入口"] } } }
      ]
    },
    "扫荡噩梦诛仙四剑": {
      "type": "switch",
      "label": "扫荡噩梦诛仙四剑",
      "default_case": "Yes",
      "cases": [
        { "name": "Yes", "pipeline_override": { "扫荡噩梦诛仙四剑入口": { "next": ["扫荡噩梦主线四剑点击地图"] } } },
        { "name": "No",  "pipeline_override": { "扫荡噩梦诛仙四剑入口": { "next": ["扫荡噩梦冥河老祖入口"] } } }
      ]
    },
    "噩梦四剑扫荡次数": {
      "type": "input",
      "inputs": [
        {
          "name": "噩梦四剑扫荡次数",
          "pipeline_type": "int",
          "default": "1",
          "verify": "^[1-9][0-9]*$"
        }
      ],
      "pipeline_override": {
        "开始噩梦诛仙四剑扫荡": { "repeat": "{噩梦四剑扫荡次数}" }
      }
    },
    "扫荡噩梦冥河老祖": {
      "type": "switch",
      "label": "扫荡噩梦冥河老祖",
      "default_case": "Yes",
      "cases": [
        { "name": "Yes", "pipeline_override": { "扫荡噩梦冥河老祖入口": { "next": ["扫荡噩梦冥河老祖点击世界"] } } },
        { "name": "No",  "pipeline_override": { "扫荡噩梦冥河老祖入口": { "next": ["清日常完成"] } } }
      ]
    },
    "噩梦冥河老祖扫荡次数": {
      "type": "input",
      "inputs": [
        {
          "name": "噩梦冥河老祖扫荡次数",
          "pipeline_type": "int",
          "default": "1",
          "verify": "^[1-9][0-9]*$"
        }
      ],
      "pipeline_override": {
        "开始噩梦冥河老祖扫荡": { "repeat": "{噩梦冥河老祖扫荡次数}" }
      }
    }
  }
}
