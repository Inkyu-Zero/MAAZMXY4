{
  "json.schemas": [
    {
      "fileMatch": [
        "/assets/resource/base/pipeline/*.json",
        "/resource/base/pipeline/*.json",
        "/templates/resource/base/pipeline/*.json"
      ],
      "url": "./schemas/pipeline.schema.json"
    },
    {
      "fileMatch": [
        "/interface.json",
        "/assets/interface.json",
        "/templates/interface.json"
      ],
      "url": "./schemas/interface.schema.json"
    }
  ],
  "files.associations": {
    "*.json": "jsonc"
  },
  "json.schemaDownload.enable": false,
  "search.exclude": {
    "**/runtimes/**": true,
    "**/debug/**": true,
    "**/dist/**": true,
    "**/.runtime-cache/**": true,
    "**/__pycache__/**": true
  },
  "files.watcherExclude": {
    "**/runtimes/**": true,
    "**/debug/**": true,
    "**/dist/**": true,
    "**/.runtime-cache/**": true
  },
  "python.analysis.extraPaths": [
    "./agent",
    "./runtimes/python/Lib/site-packages"
  ],
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingImports": "none"
  }
}
